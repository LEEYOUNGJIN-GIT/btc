# 업비트 Open API 키. 출금 권한은 끄고, 거래 권한과 IP 제한만 사용하세요.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 업비트 마켓 코드는 {호가자산}-{기준자산} 입니다. 예: USDT-BTC
MARKET=USDT-BTC

# true 이면 주문 API를 호출하지 않고 현재가만 받아 모의 체결합니다.
# 실주문은 DRY_RUN=false 와 LIVE_TRADING_CONFIRM=YES 가 둘 다 필요합니다.
DRY_RUN=true
LIVE_TRADING_CONFIRM=NO

# 모의거래 시작 USDT
DRY_RUN_QUOTE=1000

# 업비트 일반 수수료 0.05%. 실전 기동 시 주문 가능 정보 API 값이 있으면 그 값으로 덮어씁니다.
# 업비트 USDT 마켓 일반 수수료는 0.25% 입니다(원화 마켓 0.05% 와 다름). 이벤트로 일시 인하될 수 있고,
# 실전에서는 시작 시 거래소가 알려주는 수수료로 덮어씁니다. 모의거래는 이 값을 씁니다.
BUY_FEE_RATE=0.0025
SELL_FEE_RATE=0.0025

# 수수료를 뺀 뒤 남기려는 목표 순수익률. 0.0025 = 0.25%
TARGET_PROFIT_RATE=0.0025

# 매수가 대비 하락률. 0.005 = 0.5%. 도달 시 봇이 청산 주문을 넣습니다.
STOP_LOSS_RATE=0.005
# market: 시장가 손절 / limit: 최우선 매수호가 지정가(미체결 시 시장가로 승격)
STOP_LOSS_ORDER_TYPE=market
# 모의 시장가 손절에만 적용하는 불리한 슬리피지
DRY_RUN_SLIPPAGE_RATE=0.0005

# 1 이면 주문 가능한 USDT 전액. 첫 실전은 0.05~0.1 처럼 소액으로 시작하세요.
BALANCE_USE_RATIO=1
# 수수료·반올림 거절이 반복될 때만 0.01 이상으로 올리세요. 기본 0은 '전액'에 가깝게 계산합니다.
QUOTE_RESERVE=0
MIN_ORDER_QUOTE=0.5

# 박스 하단에서만 매수. 0.40 이면 박스의 아래 40% 구간에서만 진입합니다.
ENTRY_ZONE=0.40
# 박스 하단보다 이 비율 이상 내려가면 이탈로 보고 매수하지 않습니다.
BREAKDOWN_BUFFER=0.002
# 백필이 실패했을 때만 쓰는 고정 매수 이격. 0.001 = 0.10%
BUY_OFFSET_RATE=0.001

# 과거 분봉을 모아 ATR·박스·그리드 간격을 계산합니다. 24~168시간.
BACKFILL_ENABLED=true
BACKFILL_HOURS=24
BACKFILL_UNIT=1
BACKFILL_DB=data/ohlcv.sqlite
# 비우면 CSV 는 만들지 않습니다. 여러 마켓이면 파일명에 마켓을 붙입니다.
BACKFILL_CSV=
BACKFILL_PAGE_SLEEP=0.15
# 기동 시 미리 받을 마켓. 기본 BTC·ETH. MARKET 이 없으면 자동으로 앞에 붙습니다.
BACKFILL_MARKETS=USDT-BTC,USDT-ETH
ATR_PERIOD=14
RANGE_LOOKBACK=120
# 변동폭을 이 구간으로 자릅니다. 왕복 수수료 0.10%보다 넓어야 합니다.
MIN_GRID_RATE=0.002
MAX_GRID_RATE=0.004
SUPPORT_PERCENTILE=0.10
RESISTANCE_PERCENTILE=0.90
ANALYZE_REFRESH_SEC=60
DYNAMIC_REPRICE_SEC=15
# 분봉+일봉(data/daily)으로 스캘핑 구간·허용 여부를 같이 봅니다.
MULTI_TF_ENABLED=true
DAILY_DATA_DIR=data/daily
DAILY_SMA_PERIOD=20

BOX_CANDLE_UNIT=1
BOX_CANDLE_COUNT=30
CANDLE_REFRESH_SEC=30

# 미체결 매수 취소 후 재호가, 미체결 매도 재호가(손익분기 아래로는 내리지 않음)
BUY_TIMEOUT_SEC=45
SELL_REPRICE_SEC=120

# true 이면 지정가가 즉시 체결될 상황에서는 주문을 넣지 않습니다(메이커 전용).
POST_ONLY=false

LOOP_INTERVAL_SEC=1
PRICE_STALE_SEC=5
USE_WEBSOCKET=true
ORDER_TIMEOUT_HTTP=10
MAX_RETRIES=5
RETRY_DELAY_SEC=1
VOLUME_PRECISION=8

# 손절 뒤 바로 다시 진입하지 않는 시간(초). 이익 청산에는 적용하지 않습니다.
POST_STOP_COOLDOWN_SEC=15
# USDT 기준 당일 누적 실현손실이 이 값 이상이면 신규 매수를 멈춥니다(HALT).
# 실전(DRY_RUN=false)에서는 0 보다 커야 시작합니다. 끄려면 ALLOW_NO_LOSS_LIMIT=true 를 명시해야 합니다.
MAX_DAILY_LOSS_QUOTE=0
ALLOW_NO_LOSS_LIMIT=false
# 1회 매수에 쓰는 최대 USDT. 0 이면 제한 없음. 첫 실전은 소액으로 시작하세요.
MAX_ORDER_QUOTE=0

# 0 이면 종료 신호를 받을 때까지 반복
MAX_RUNTIME_SEC=0
LIVE_COUNTDOWN_SEC=5
CANCEL_BUY_ON_EXIT=true

LOG_FILE=trading.log
LOG_LEVEL=INFO
STATE_FILE=position_state.json

# --- 운영 안전장치 ---
# 손절 실행 여부. 기본 false(손절 안 함). true 일 때만 STOP_LOSS_RATE 에서 청산합니다.
STOP_LOSS_ENABLED=false

# 매수 호가와 매도 호가의 간격이 이 비율보다 넓으면 신규 매수를 하지 않습니다. 0 이면 끔.
MAX_SPREAD_RATE=0.001

# 이 파일이 존재하면 신규 매수를 멈추고 대기 중인 매수를 취소합니다(보유 포지션은 계속 관리, 손절 포함).
KILL_SWITCH_FILE=STOP
# 이 파일이 존재하면 위 동작에 더해 보유 코인을 시장가로 전량 청산합니다.
FLATTEN_FILE=FLATTEN
# 10초마다 갱신되는 생존 표시 파일
HEARTBEAT_FILE=bot.heartbeat
# 루프 오류가 이 횟수만큼 연속되면 알림
ERROR_ALERT_THRESHOLD=5

# 텔레그램 알림(둘 다 채우거나 둘 다 비움). 매수 체결, 청산 손익, 손절, HALT, 오류 연속 발생을 알려줍니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# healthchecks.io 같은 생존 신호 URL. 봇/서버가 통째로 죽으면 핑이 끊겨 외부 서비스가 알려줍니다.
HEALTHCHECK_URL=

# ===== 전략 모드 =====
# ladder: 분할 구간 매매(기본, 권장). scalp: 기존 단일 사이클 스캘핑(USDT 마켓에서는 스프레드 게이트에 막혀 거의 주문하지 않음).
STRATEGY_MODE=ladder

# --- 분할 구간(ladder) ---
# 투입할 USDT 총액. 봇은 이 금액을 넘겨 사지 않습니다. 실전에서는 반드시 0보다 크게 설정.
LADDER_BUDGET_QUOTE=0
# 구간 간격이자 구간별 매도 목표. 왕복 수수료의 2배 미만이면 시작하지 않습니다.
LADDER_STEP_RATE=0.03
# 구간 수. 구간당 투입액 = LADDER_BUDGET_QUOTE / LADDER_SLOTS
LADDER_SLOTS=10
# 앵커(구간 기준가). price: 처음 시작할 때의 현재가(보유 구간이 없을 때만 시세를 따라 올라감). high: 직전 N일 최고 종가.
LADDER_ANCHOR_MODE=price
# price 모드에서 보유 구간이 없을 때, 시세가 앵커보다 이 비율 이상 오르면 앵커를 현재가로 올립니다.
LADDER_REANCHOR_RATE=0.005
# high 모드에서 쓸 최고 종가의 조회 일수(완성된 UTC 일봉, 2~199)
LADDER_LOOKBACK_DAYS=120
# 동시에 걸어 둘 매수 주문 수(가까운 구간부터)
LADDER_MAX_OPEN_BUYS=3
LADDER_ANCHOR_REFRESH_SEC=3600
LADDER_POLL_SEC=5
LADDER_STATE_FILE=ladder_state.json
